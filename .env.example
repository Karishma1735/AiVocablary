# Copy this file to .env. Never commit real credentials.
DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-at-least-32-random-characters"
GEMINI_API_KEY=""
# Current stable text model in Google's Gemini API model guide; access depends on key/account/region.
GEMINI_MODEL="gemini-3.8-flash"
# Add a long random value only if you enable the future viaSocket API.
INTEGRATION_API_KEY=""
PORT=4000
NODE_ENV=development
# viaSocket embed (flow.viasocket.com/integrations -> Configuration -> Create new embed). Server-side only.
VIASOCKET_ORG_ID=""
VIASOCKET_PROJECT_ID=""
VIASOCKET_EMBED_SECRET=""
